# SimulateAI Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# LLM Provider: "ollama", "gemini", or "openai"
LLM_PROVIDER=openai

# Ollama (local) — only needed if LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# Google AI Studio Gemini — only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# OpenAI-compatible API — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Concurrency & Timeout
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=120.0

# Public demo security and retention
ADMIN_API_KEY=
RATE_LIMIT_SALT=replace-with-a-random-secret
TRUST_PROXY_HEADERS=false
WEBHOOKS_ENABLED=false
RUN_RETENTION_DAYS=7
JOB_RETENTION_SECONDS=900

# RAG (web search enrichment via Brave Search)
RAG_ENABLED=true
BRAVE_API_KEY=
